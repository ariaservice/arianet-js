{
  "name": "arianet",
  "version": "0.1.0",
  "description": "Official JavaScript/TypeScript client for the Arianet (Ariaservice) public API",
  "license": "MIT",
  "author": "Ariaservice <git@ariaservice.net>",
  "homepage": "https://docs.ariaservice.net/sdk/js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariaservice/arianet-js.git"
  },
  "bugs": "https://github.com/ariaservice/arianet-js/issues",
  "keywords": [
    "arianet",
    "ariaservice",
    "cloud",
    "vps",
    "hosting",
    "sms",
    "api",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/client.test.mjs",
    "prepublishOnly": "npm test",
    "typecheck": "npm run build && tsc -p test/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
